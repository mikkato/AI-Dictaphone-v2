<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DeviceDefault DayNight (аудит F20): стартовое окно подстраивается под
         системную тему (API 29+) — не мигает белым при тёмной теме. Цвета баров
         задает enableEdgeToEdge из MainActivity. -->
    <style name="Theme.Dictaphone" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
