# Large files: plan — перевести модели/вендорные артефакты на git-lfs
# (в этом прогоне сознательно НЕ делаем: переписывание истории сломает сборки
# и CI; файлы, читаемые кодом, из working tree не удаляем).
*.bin filter=lfs diff=lfs merge=lfs -text
*.gguf filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.aar filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text
*.apk filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text

# Линейки End-of-line: исходники — LF, батчи Windows не используем
* text=auto
*.kt text eol=lf
*.kts text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.xml text eol=lf
*.md text eol=lf

# Бинарные — не пытаться диффить/мерджить
*.png binary
*.webp binary
*.wav binary
*.mp3 binary
*.jar binary
